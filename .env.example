# ==========================================
# EXPIRY DATE MANAGER - EXPRESS SERVER ENV
# ==========================================

# Port for Express server (Render sets PORT dynamically in production)
PORT=5001

# Application environment mode (development | production)
NODE_ENV=production

# MongoDB Atlas Database Connection String
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net/expiry_date_manager?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Secret key for JWT authentication token signing
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Client URL allowed for CORS requests (Netlify deployment URL)
# Can accept multiple comma-separated origins e.g.: https://your-app.netlify.app,http://localhost:5173
CLIENT_URL=https://your-app-name.netlify.app

# Backend Server Public Base URL (Used for Swagger UI API Docs)
SERVER_URL=https://your-server-name.onrender.com
